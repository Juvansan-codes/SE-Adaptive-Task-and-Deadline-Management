# Root .gitignore for SE-Adaptive-Task-and-Deadline-Management

# Dependencies
node_modules/
*/node_modules/

# Next.js build outputs
.next/
*/.next/
out/
*/out/

# Environment variables
.env*
!.env.example
*.env.local

# Database files
*.db
*.sqlite
*.sqlite3

# Python caches and virtual environments
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
.venv/
*/.venv/
.pytest_cache/
*/.pytest_cache/

# Local tokens and credentials
auth_token.json
*token*.json

# OS files
.DS_Store
Thumbs.db

