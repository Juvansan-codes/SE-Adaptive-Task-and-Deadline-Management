# ==============================================================================
# Adaptive Task & Deadline Management API - Environment Configuration
# ==============================================================================
# Copy this file to `.env` in the `backend/` directory for local execution:
#   Copy-Item .env.example .env
#
# NOTE: Never commit `.env` containing actual database credentials or secrets.
# ==============================================================================

# Application Environment: development | staging | production
APP_ENV=development

# Application Metadata
APP_TITLE=Adaptive Task & Deadline Management API
APP_VERSION=0.1.0

# Database Configuration (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# In Supabase: Project Settings -> Database -> Connection Pooling -> Connection string (URI)
# Format: postgresql+psycopg://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres
# For local PostgreSQL instance:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/adaptive_tasks
DATABASE_URL=

# Supabase Auth Configuration
# ------------------------------------------------------------------------------
# In Supabase: Project Settings -> API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Allowed Frontend Origin for CORS
# ------------------------------------------------------------------------------
# Points to local Next.js development server
FRONTEND_ORIGIN=http://localhost:3000

