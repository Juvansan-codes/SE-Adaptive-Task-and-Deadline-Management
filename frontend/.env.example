# Adaptive Task & Deadline Management - Frontend Environment Variables
# Copy this file to .env.local for local development

# Base URL for backend API services (browser-accessible, do NOT put secrets here)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Supabase Client Public Credentials (found in Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
